// Cloudflare deploy: the repo root is the static site, sync/worker.js is the relay (one Durable Object per room).
// `cf deploy` (or `npx wrangler deploy`). Then open https://<host>/?ws=wss://<host>
{
	"name": "roughjam",
	"main": "sync/worker.js",
	"compatibility_date": "2026-11-01",
	// run_worker_first: "/" so WebSocket upgrades to the root reach the Worker instead of index.html
	"assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/"] },
	"durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "JamRoom" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["JamRoom"] }],
	"routes": [{ "pattern": "jam.0sk.ar", "custom_domain": true }]
}
